<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Hours Column 1 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:id="@+id/h1_8" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal" android:visibility="invisible"/>
        <ImageView android:id="@+id/h1_4" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal" android:visibility="invisible"/>
        <ImageView android:id="@+id/h1_2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/h1_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_bulb_off_normal"/>
    </LinearLayout>

    <!-- Hours Column 2 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:id="@+id/h2_8" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/h2_4" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/h2_2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/h2_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_bulb_off_normal"/>
    </LinearLayout>

    <Space android:layout_width="16dp" android:layout_height="match_parent" />

    <!-- Minutes Column 1 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:id="@+id/m1_8" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal" android:visibility="invisible"/>
        <ImageView android:id="@+id/m1_4" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/m1_2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/m1_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_bulb_off_normal"/>
    </LinearLayout>

    <!-- Minutes Column 2 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:id="@+id/m2_8" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/m2_4" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/m2_2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/m2_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_bulb_off_normal"/>
    </LinearLayout>

    <Space android:layout_width="16dp" android:layout_height="match_parent" />

    <!-- Seconds Column 1 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:id="@+id/s1_8" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal" android:visibility="invisible"/>
        <ImageView android:id="@+id/s1_4" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/s1_2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/s1_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_bulb_off_normal"/>
    </LinearLayout>

    <!-- Seconds Column 2 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:id="@+id/s2_8" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/s2_4" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/s2_2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_bulb_off_normal"/>
        <ImageView android:id="@+id/s2_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_bulb_off_normal"/>
    </LinearLayout>

</LinearLayout>
